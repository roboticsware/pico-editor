{
  "name": "pico-editor",
  "version": "0.0.1",
  "description": "Pico Editor - Both Block and Text based Coding Editor in Web/PC hybrid environment for Raspberry Pi Pico with Blockly and Python support.",
  "author": "JeongJun Lee (ReboticsWare)",
  "license": "AGPL-3.0-only",
  "keywords": [
    "Raspberry Pi Pico",
    "Blockly",
    "Microcontroller",
    "Python",
    "MicroPython",
    "Code Editor",
    "Web-based IDE",
    "Electron-based Offline IDE",
    "Multi-platform support "
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roboticsware/pico-editor.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "electron:publish": "npm run electron:build && cd electron && npm run dist",
    "electron:build": "cross-env CONF_PLATFORM=electron npm run build && npx cap copy electron",
    "electron:open": "npx cap open electron",
    "electron:debug": "electron . --remote-debugging-port=9222",
    "electron:make:mac": "npm run electron:build && cd electron && npm run build:mac",
    "electron:make:win": "npm run electron:build && cd electron && npm run build:win",
    "electron:make:linux": "npm run electron:build && cd electron && npm run build:linux",
    "android:build": "npm run build && npx cap copy android && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:build && npx cap run android"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@ionic/vue": "^8.7.17",
    "@ionic/vue-router": "^8.7.17",
    "blockly": "^12.3.1",
    "codemirror": "^6.0.2",
    "cordova-plugin-wifiwizard2": "github:tripflex/wifiwizard2",
    "ionicons": "^8.0.13",
    "lucide-vue-next": "^0.562.0",
    "pinia": "^3.0.4",
    "splitpanes": "^4.0.4",
    "vue": "^3.5.26",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/dom-serial": "^1.0.6",
    "@types/node": "22",
    "@types/splitpanes": "^2.2.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/cli-service": "5.0.9",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.1"
  }
}